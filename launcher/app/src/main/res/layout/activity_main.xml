<?xml version="1.0" encoding="utf-8"?>
<!-- Canvas is 960 x 540 dp (1920x1080 @ 320 dpi). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <!-- Home photo (or the default gradient): 1440x1080 px = 720dp x full height, right-aligned. Left 480 px stays solid base. -->
    <ImageView android:id="@+id/hero_photo" android:layout_width="720dp" android:layout_height="match_parent"
        android:layout_gravity="end" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <!-- Left: solid 0-240dp, then fade to transparent by 432dp (45% of the width). -->
    <View android:layout_width="240dp" android:layout_height="match_parent" android:background="@color/bg" />
    <View android:layout_width="192dp" android:layout_height="match_parent" android:layout_marginStart="240dp"
        android:background="@drawable/scrim_fade" />
    <!-- Focused app's colour, only over the dark left side (fades out where the photo begins). Photo stays untouched. -->
    <View android:id="@+id/ambient_a" android:layout_width="432dp" android:layout_height="match_parent" />
    <View android:id="@+id/ambient_b" android:layout_width="432dp" android:layout_height="match_parent" android:alpha="0" />
    <View android:layout_width="match_parent" android:layout_height="230dp" android:layout_gravity="bottom" android:background="@drawable/scrim_bottom" />
    <!-- Top bar sits on the photo; a short top scrim keeps the pills readable. -->
    <View android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/scrim_top" />

    <!-- top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="48dp" android:layout_marginTop="30dp" android:layout_marginEnd="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:id="@+id/clock_pill" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/pill_glass"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="18dp">
            <include layout="@layout/clock_time_ampm" />
            <TextClock android:id="@+id/clock_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:format12Hour="EEE d MMM" android:format24Hour="EEE d MMM" android:textColor="@color/text_dim" android:textSize="13sp" />
            <LinearLayout android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <View android:layout_width="1dp" android:layout_height="20dp" android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp" android:background="@drawable/divider_v" />
                <ImageView android:id="@+id/weather_icon" android:layout_width="18dp" android:layout_height="18dp" android:alpha="0.9" />
                <TextView android:id="@+id/weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:textColor="@color/text" android:textSize="15sp" />
                <TextView android:id="@+id/weather_city" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textColor="@color/text_dim" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginEnd="-20dp"
            android:background="@drawable/pill_glass" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="11dp" android:paddingEnd="13dp">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_memory" android:alpha="0.85" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="RAM" android:textColor="@color/text" android:textSize="11sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/ram_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="@color/text_dim" android:textSize="11sp" />
            <ProgressBar android:id="@+id/ram_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="36dp" android:layout_height="3dp" android:layout_marginStart="9dp"
                android:max="100" android:progressDrawable="@drawable/ram_bar" />
        </LinearLayout>
    </LinearLayout>

    <!-- hero -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="48dp" android:layout_marginTop="112dp" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <View android:id="@+id/accent_line" android:layout_width="20dp" android:layout_height="2dp" android:background="@color/accent" />
            <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:textColor="@color/text_dim" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/hero_title" android:layout_width="560dp" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" android:letterSpacing="-0.02" android:maxLines="1"
            android:textColor="@color/text" android:textSize="60sp" />
        <TextView android:id="@+id/hero_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/text_dim" android:textSize="15sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/pill_white"
                android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="16dp">
                <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/badge_dark"
                    android:gravity="center" android:text="OK" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="to open" android:textColor="#FF111114" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="10dp"
                android:background="@drawable/pill_glass" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="16dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="App info  (Menu)" android:textColor="@color/text" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- favourites row + hints -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical"
        android:paddingStart="48dp" android:paddingBottom="22dp">
        <TextView android:id="@+id/row_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textColor="@color/text_faint" android:textSize="13sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/app_row" android:layout_width="match_parent"
            android:layout_height="112dp" android:clipChildren="false" android:clipToPadding="false"
            android:paddingStart="2dp" android:paddingTop="14dp" android:paddingEnd="48dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingEnd="48dp">
            <TextView android:id="@+id/focus_hint" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/text_dim" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/key_badge"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:text="◀ ▶" android:textColor="@color/text_dim" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="navigate" android:textColor="@color/text_faint" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                android:background="@drawable/key_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:text="OK"
                android:textColor="@color/text_dim" android:textSize="10sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="open" android:textColor="@color/text_faint" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
